# conssswars-web 環境變數範例。
#
# 這些值只會出現在 Cloudflare Pages Functions 端，不會進前端 bundle。
# 本機開發：複製成 .env（已在 .gitignore 裡），npm run dev 會自動載入。
# 線上部署：Dashboard → Settings → Variables and Secrets，金鑰請選 Secret（加密）。

# ══ 賽道一之一：敵方 AI agent「遺忘者」 ══════════════════════════
# 每回合讀盤下決策的那個對手。預設走 OpenAI。
# 想讓敵方 agent 也跑在 0G Compute 上，把這行改成 AI_PROVIDER=0g 即可，程式碼不用動。
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ══ 賽道一之二：0G Compute Network（戰後旁白「記憶編纂者」）══════
# 跑在 TEE 上的可驗證推論。金鑰從 https://pc.0g.ai 取得。
# 沒設也能玩，旁白會退到本地模板並照實標示「未接上 0G Compute」。
OG_COMPUTE_API_KEY=sk-your-0g-router-key
OG_COMPUTE_MODEL=deepseek-chat-v3-0324
# OG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1

# ══ 賽道二：0G Storage ══════════════════════════════════════════
# 唯讀查詢（indexer）不需要金鑰，預設就會通。
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# 寫入需要私鑰付 Flow 合約的費用，所以掛一個 0g-storage-client gateway 來收，
# Worker 裡不放私鑰。設了這個端點，記憶碎片才會真的上傳到 0G Storage。
OG_STORAGE_UPLOAD_URL=
OG_STORAGE_TOKEN=

# ══ 賽道三：0G Chain（Galileo 測試網 16601）══════════════════════
# 不設就用公開節點。錨定交易由玩家自己的錢包送出，伺服器不保管任何私鑰。
OG_RPC_URL=https://evmrpc-testnet.0g.ai
