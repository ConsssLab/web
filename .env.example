# conssswars-web 的 Cloudflare Pages 環境變數範例。
# 這些值只會出現在 Pages Functions 端，不會進前端 bundle。
# 在 Dashboard → Settings → Variables and Secrets 設定，金鑰請選 Secret（加密）。

# ── 敵方 AI agent ───────────────────────────────
# openai（預設，本版指定）或 0g（改走 0G Compute Network Router）
AI_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# AI_PROVIDER=0g 時才會用到。金鑰從 pc.0g.ai 取得
OG_COMPUTE_API_KEY=sk-your-0g-router-key
OG_COMPUTE_MODEL=deepseek-chat-v3-0324

# ── 0G Chain ────────────────────────────────────
# 不設就用 0G Galileo 測試網公開節點
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# ── 0G Storage（選用）───────────────────────────
# 設了才會真的上傳記憶碎片；沒設就只產生 SHA-256 摘要，由玩家錢包錨定上鏈
OG_STORAGE_UPLOAD_URL=
OG_STORAGE_TOKEN=
